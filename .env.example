# Скопируйте этот файл в .env и при необходимости отредактируйте.
# docker compose читает .env из корня проекта автоматически.

# --- Общее ---
ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=hobbylife
POSTGRES_PASSWORD=hobbylife
POSTGRES_DB=hobbylife
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://hobbylife:hobbylife@postgres:5432/hobbylife

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- S3 / MinIO ---
# Локальная разработка (docker-compose.yml поднимает MinIO как S3-совместимое хранилище):
MINIO_ROOT_USER=hobbylife
MINIO_ROOT_PASSWORD=hobbylife123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=hobbylife
S3_ACCESS_KEY=hobbylife
S3_SECRET_KEY=hobbylife123
S3_PUBLIC_URL=http://localhost:9000/hobbylife
# Прод (docker-compose.prod.yml без MinIO, см. docs/DEPLOY.md) — например, Cloudflare R2:
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=hobbylife
# S3_ACCESS_KEY=<R2 access key id>
# S3_SECRET_KEY=<R2 secret access key>
# S3_PUBLIC_URL=https://<публичный домен бакета или R2.dev URL>/hobbylife

# --- Caddy / домен (заполняется перед прод-деплоем, см. Задачу 5.3 и docs/DEPLOY.md) ---
DOMAIN=localhost
# Контактный email для Let's Encrypt (используется только Caddyfile.prod, не влияет на dev).
ACME_EMAIL=admin@example.com

# --- Бэкапы БД (используется начиная с Задачи 5.3, только в docker-compose.prod.yml) ---
BACKUP_RETENTION_DAYS=14

# --- Auth: JWT (используется начиная с Задачи 1.2) ---
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-value-at-least-32-bytes
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- Email / SMTP (используется начиная с Задачи 1.2) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@hobbylife.kg

# --- CORS (используется начиная с Задачи 0.2) ---
CORS_ORIGINS=http://localhost

# --- Платежи (используется начиная с Задачи 4.1) ---
PAYMENT_PROVIDERS=mock
PAYMENT_WEBHOOK_SECRET=change-me-in-production

# --- Доставка по Бишкеку (используется начиная с Задачи 3.2) ---
COURIER_DELIVERY_COST=150
FREE_DELIVERY_THRESHOLD=3000
